---
import type { FaqItem } from '../data/site';

interface Props {
  items: FaqItem[];
  title?: string;
  id?: string;
}

const { items, title = 'Common questions', id = 'faqs' } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6 lg:px-8">
  <h2 class="font-display text-3xl font-bold tracking-tight text-teal sm:text-4xl">
    {title}
  </h2>
  <div class="mt-8 divide-y divide-teal/10 border-y border-teal/10">
    {
      items.map((item) => (
        <details class="group py-5">
          <summary class="cursor-pointer list-none font-semibold text-teal outline-none marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-start justify-between gap-4">
              <span>{item.q}</span>
              <span class="mt-0.5 text-clay transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </span>
          </summary>
          <p class="mt-3 max-w-3xl text-base leading-relaxed text-ink-soft">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
