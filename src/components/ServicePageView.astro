---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CallCard from './CallCard.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import type { ServicePage } from '../data/services';
import { services, site } from '../data/site';
import { breadcrumbSchema, faqSchema, localBusinessSchema, serviceSchema } from '../lib/schema';

interface Props {
  service: ServicePage;
}

const { service } = Astro.props;
const related = services.filter((s) => s.slug !== service.slug).slice(0, 4);
---

<BaseLayout
  title={service.metaTitle}
  description={service.description}
  schema={[
    localBusinessSchema(),
    serviceSchema({
      name: service.h1,
      description: service.description,
      path: service.path,
    }),
    faqSchema(service.faqs),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/#services' },
      { name: service.title, path: service.path },
    ]),
  ]}
>
  <Breadcrumbs
    items={[
      { name: 'Home', href: '/' },
      { name: 'Services', href: '/#services' },
      { name: service.title },
    ]}
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-clay">
          Intent tier: {service.intentTier}
        </p>

        <!-- Single H1: Santa Fe–specific service headline -->
        <h1
          class="mt-3 font-display text-3xl font-bold tracking-tight text-teal sm:text-4xl lg:text-5xl"
        >
          {service.h1}
        </h1>

        <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-soft sm:text-lg">
          {service.intro.map((p) => <p>{p}</p>)}
        </div>

        <a href={site.contactHref} class="btn-primary cta-pulse mt-8">
          Request Service
        </a>
      </div>

      <CallCard heading={service.callCardHeading} steps={service.process} />
    </div>
  </section>

  <section class="border-y border-teal/10 bg-sand-deep/35">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
      <!-- Secondary keyword H2 -->
      <h2 class="font-display text-3xl font-bold tracking-tight text-teal">
        {service.secondaryH2}
      </h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          service.bullets.map((b) => (
            <li class="flex gap-3 border-b border-teal/10 pb-4 text-base text-teal">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay" aria-hidden="true" />
              {b}
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-2xl text-base leading-relaxed text-ink-soft">
        Still unsure? If you’re dealing with {service.primaryKeyword}, request service with{' '}
        {site.name} and we’ll tell you if it’s urgent or can wait.
      </p>
    </div>
  </section>

  <Faq items={service.faqs} title={`${service.title} FAQs`} />

  <section class="mx-auto max-w-6xl px-4 pb-4 sm:px-6 lg:px-8">
    <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-sage">Related services</h2>
    <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
      {
        related.map((s) => (
          <li>
            <a href={s.href} class="link-tertiary text-base">
              {s.title} in Santa Fe
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand
    heading={`Need ${service.title.toLowerCase()} in Santa Fe?`}
    body="Tell us your ZIP and what’s going on—we confirm Santa Fe County coverage and get a local tech moving."
  />
</BaseLayout>
