---
interface Props {
  name:
    | 'pumping'
    | 'repair'
    | 'inspection'
    | 'safety'
    | 'leaf'
    | 'schedule'
    | 'local'
    | 'support'
    | 'heart';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'pumping' && (
      <>
        <path d="M12 3c-2.5 4-5 6.8-5 10a5 5 0 0010 0c0-3.2-2.5-6-5-10z" />
        <path d="M10 14c.5 1.2 1.2 1.8 2 1.8" />
      </>
    )
  }
  {
    name === 'repair' && (
      <path d="M14.7 6.3a4 4 0 01-5.1 5.1L4 17l3 3 5.6-5.6a4 4 0 015.1-5.1l-2.2 2.2-1.8-.2-.2-1.8 2.2-2.2z" />
    )
  }
  {
    name === 'inspection' && (
      <>
        <circle cx="10.5" cy="10.5" r="5.5" />
        <path d="M15 15l5 5" />
      </>
    )
  }
  {
    name === 'safety' && (
      <>
        <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" />
        <path d="M9.5 12l1.8 1.8L15 10" />
      </>
    )
  }
  {
    name === 'leaf' && (
      <>
        <path d="M5 13c4-8 14-9 14-9s1 10-7 14c-3 1.5-6 1-7-1 2-.5 4-2 4-4S7 11 5 13z" />
        <path d="M9 15c2-2 4-5 5-8" />
      </>
    )
  }
  {
    name === 'schedule' && (
      <>
        <rect x="3.5" y="5" width="17" height="15" rx="2" />
        <path d="M8 3.5V7M16 3.5V7M3.5 10h17" />
        <circle cx="12" cy="15" r="2.2" />
        <path d="M12 15v-1.6M12 15l1.2.9" />
      </>
    )
  }
  {
    name === 'local' && (
      <>
        <path d="M12 21s6-5.2 6-11a6 6 0 10-12 0c0 5.8 6 11 6 11z" />
        <circle cx="12" cy="10" r="2.2" />
      </>
    )
  }
  {
    name === 'support' && (
      <>
        <path d="M5 16.5V8a3 3 0 013-3h8a3 3 0 013 3v5a3 3 0 01-3 3H10l-5 3v-2.5z" />
        <path d="M9.2 11.2c.6-.7 1.4-1 2.3-1 1.5 0 2.5 1 2.5 2.2 0 1.6-2.5 2.4-2.5 2.4" />
      </>
    )
  }
  {
    name === 'heart' && (
      <path d="M12 19s-6.5-4.2-6.5-9A3.5 3.5 0 0112 7.2 3.5 3.5 0 0118.5 10c0 4.8-6.5 9-6.5 9z" />
    )
  }
</svg>
