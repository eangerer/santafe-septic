---
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="border-b border-ink/8 bg-sand/30">
  <ol
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-4 py-3 text-xs font-medium text-ink-soft sm:px-6 lg:px-8"
  >
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <span class="text-sage" aria-hidden="true">
              /
            </span>
          )}
          {item.href ? (
            <a href={item.href} class="hover:text-juniper">
              {item.name}
            </a>
          ) : (
            <span class="text-ink">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
