---
import BrandIcons from './BrandIcons.astro';
import { homeSeo } from '../data/seo';
import { site, trustPoints } from '../data/site';
---

<section class="relative overflow-hidden bg-teal">
  <div class="mx-auto grid max-w-6xl lg:grid-cols-2">
    <!-- Left: brand + SEO copy -->
    <div class="flex flex-col justify-center px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
      <p class="reveal text-xs font-bold uppercase tracking-[0.2em] text-gold">
        {homeSeo.kicker}
      </p>

      <h1
        class="reveal reveal-delay-1 mt-4 font-display text-4xl font-bold leading-tight tracking-tight text-sand sm:text-5xl"
      >
        {homeSeo.h1}
      </h1>

      <p class="reveal reveal-delay-2 mt-4 max-w-md text-lg leading-relaxed text-sand/85">
        {homeSeo.subhead}
      </p>

      <p class="reveal reveal-delay-2 mt-3 max-w-md text-base leading-relaxed text-sand/70">
        {homeSeo.body}
      </p>

      <div class="reveal reveal-delay-3 mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={site.contactHref} class="btn-on-teal cta-pulse">
          Request Service
        </a>
        <a href={homeSeo.secondaryCta.href} class="btn-ghost-light">
          {homeSeo.secondaryCta.label}
        </a>
      </div>

      <ul class="reveal reveal-delay-3 mt-10 grid gap-4 sm:grid-cols-3">
        {
          trustPoints.map((point) => (
            <li class="flex items-start gap-2.5 text-sm text-sand/85">
              <span class="mt-0.5 text-gold">
                <BrandIcons name={point.icon} class="h-5 w-5" />
              </span>
              <span class="leading-snug">{point.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right: brand illustration (full-bleed on large screens) -->
    <div class="relative min-h-[280px] sm:min-h-[360px] lg:min-h-full">
      <img
        src="/brand/hero-mascot.png"
        alt="Santa Fe Septic mascot — friendly septic pro in a high-desert adobe landscape"
        class="absolute inset-0 h-full w-full object-cover object-center"
        width="1200"
        height="900"
        fetchpriority="high"
      />
      <div
        class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-teal to-transparent lg:w-24"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>
