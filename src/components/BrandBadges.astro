        <path
          d="M12 20V9M12 9c-2 0-3.5-1.5-3.5-3.5S12 3 12 3s3.5 1 3.5 2.5S14 9 12 9zM8 14c-1.5.5-3 2-3 3.5M16 14c1.5.5 3 2 3 3.5"
