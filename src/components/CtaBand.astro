---
import { site } from '../data/site';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Need a septic pro in Santa Fe?',
  body = 'Request service for pumping, repair, inspection, or a new system quote. Same-day options when schedule allows.',
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="relative overflow-hidden rounded-2xl bg-teal px-6 py-10 text-sand sm:px-10 sm:py-12">
    <div
      class="pointer-events-none absolute -right-16 -top-20 h-56 w-56 rounded-full bg-gold/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 left-10 h-48 w-48 rounded-full bg-clay/25 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-2xl">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{heading}</h2>
      <p class="mt-3 text-base leading-relaxed text-sand/80 sm:text-lg">{body}</p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={site.contactHref} class="btn-on-teal cta-pulse">Request Service</a>
        <a href={site.contactHref} class="btn-ghost-light">Request a Callback</a>
      </div>
    </div>
  </div>
</section>
