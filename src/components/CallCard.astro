---
import { site } from '../data/site';

interface Props {
  heading: string;
  steps: { title: string; body: string }[];
}

const { heading, steps } = Astro.props;
---

<aside
  class="rounded-xl bg-teal px-6 py-7 text-sand shadow-lg shadow-teal-deep/20 sm:px-7"
  aria-label="Request service"
>
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold">{heading}</p>
  <a
    href={site.contactHref}
    class="mt-3 block font-display text-3xl font-bold tracking-tight text-sand transition hover:text-gold sm:text-4xl"
  >
    Request Service
  </a>
  <p
    class="mt-3 inline-flex rounded-md bg-gold px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-teal"
  >
    Free to request
  </p>
  <p class="mt-4 text-sm leading-relaxed text-sand/80">
    Tell us the problem and your ZIP—we connect you to a licensed septic pro who covers that part of
    Santa Fe County.
  </p>
  <a href={site.contactHref} class="btn-on-teal cta-pulse mt-6 w-full">
    Request a Callback
  </a>
  <ul class="mt-6 space-y-3 border-t border-sand/15 pt-5">
    {
      steps.map((step) => (
        <li class="flex gap-3 text-sm leading-snug text-sand/80">
          <span class="mt-1.5 h-px w-4 shrink-0 bg-clay" aria-hidden="true" />
          <span>
            <span class="font-semibold text-sand">{step.title}.</span> {step.body}
          </span>
        </li>
      ))
    }
  </ul>
</aside>
