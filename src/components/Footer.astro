---
import Logo from './Logo.astro';
import { areas, services, site } from '../data/site';
---

<footer class="mt-16 bg-teal text-sand">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3 lg:px-8">
    <div>
      <Logo variant="sand" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-sand/75">
        Local septic pumping, repair, inspection, and installation across Santa Fe and Santa Fe
        County.
      </p>
      <a
        href={site.contactHref}
        class="mt-5 inline-block text-lg font-semibold tracking-tight text-sand underline decoration-gold/70 underline-offset-4"
      >
        Request Service
      </a>
      <p class="mt-2 text-sm text-sand/65">{site.hours}</p>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold">Services</p>
      <ul class="mt-4 space-y-2">
        {
          services.map((s) => (
            <li>
              <a href={s.href} class="text-sm text-sand/80 transition hover:text-sand">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold">Service areas</p>
      <ul class="mt-4 space-y-2">
        {
          areas.map((a) => (
            <li>
              <a href={a.href} class="text-sm text-sand/80 transition hover:text-sand">
                {a.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/about/" class="text-sm text-sand/80 transition hover:text-sand">About</a>
        </li>
        <li>
          <a href="/contact/" class="text-sm text-sand/80 transition hover:text-sand">Contact</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Desert horizon brand detail -->
  <div class="border-t border-sand/10 px-4 pt-6" aria-hidden="true">
    <svg
      class="mx-auto h-12 w-full max-w-3xl text-sand/25"
      viewBox="0 0 600 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0 36c40-8 70-22 100-22 40 0 55 18 90 18 30 0 45-14 80-14 50 0 70 20 110 20 35 0 55-16 90-16 40 0 60 14 130 14v12H0V36z"
        fill="currentColor"
        opacity="0.35"></path>
      <path
        d="M40 36V24h10v-6h14v6h8v8M480 36v-10h8v-5h12v5h6v10"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"></path>
      <circle cx="300" cy="12" r="5" stroke="currentColor" stroke-width="1.3"></circle>
      <path
        d="M200 36c0-8 4-14 4-14s4 6 4 14M205 22v-6M190 36c0-6 3-10 3-10s3 4 3 10"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"></path>
    </svg>
  </div>

  <div class="border-t border-sand/10">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-sand/55 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
    >
      <p>© {new Date().getFullYear()} {site.name}. Serving {site.city}, {site.state}.</p>
    </div>
  </div>
</footer>
